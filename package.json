{
  "name": "nbody",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nbody/web dev",
    "build": "pnpm --filter @nbody/web build",
    "preview": "pnpm --filter @nbody/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test",
    "bench": "pnpm --filter @nbody/tool-bench bench"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@nbody/protocol": "workspace:*",
    "@nbody/engine": "workspace:*",
    "@nbody/scenarios": "workspace:*"
  }
}
